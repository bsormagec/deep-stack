---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description ?? 'AI tools, local models, and the honest cost of building with them.'} />
<style is:global>
  :root { --bg:#0d0b23; --panel:#161335; --ink:#e7e5fa; --muted:#a19acb; --cyan:#2ad2f4; --magenta:#db6ff6; --amber:#fbac23; --green:#2bca6d; --line:#2a2460; --codebg:#1c1844; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font-family: ui-serif, Georgia, 'Times New Roman', serif; line-height:1.65; }
  header.site { border-bottom:1px solid var(--line); padding:20px 24px; display:flex; justify-content:space-between; align-items:baseline; max-width:820px; margin:0 auto; }
  header.site a.brand { color:var(--ink); text-decoration:none; font-family: ui-sans-serif, system-ui, sans-serif; font-weight:800; font-size:22px; letter-spacing:-0.02em; }
  header.site a.brand span { background:linear-gradient(90deg, var(--cyan), var(--magenta), var(--amber)); -webkit-background-clip:text; background-clip:text; color:transparent; }
  header.site .tag { color:var(--muted); font-family: ui-sans-serif, system-ui, sans-serif; font-size:13px; }
  main { max-width:820px; margin:0 auto; padding:32px 24px 64px; }
  footer.site { max-width:820px; margin:0 auto; padding:24px; border-top:1px solid var(--line); color:var(--muted); font-family: ui-sans-serif, system-ui, sans-serif; font-size:13px; }
  h1, h2, h3 { font-family: ui-sans-serif, system-ui, sans-serif; letter-spacing:-0.02em; line-height:1.2; }
  a { color:var(--cyan); }
  .card { background:var(--panel); border:1px solid var(--line); border-radius:14px; overflow:hidden; margin-bottom:28px; }
  .card img { width:100%; display:block; aspect-ratio:3/1; object-fit:cover; }
  .card .pad { padding:20px 24px 24px; }
  .card h2 { margin:0 0 8px; font-size:24px; }
  .card h2 a { color:var(--ink); text-decoration:none; }
  .card p { margin:0; color:var(--muted); }
  .card time, article time { color:var(--green); font-family: ui-sans-serif, system-ui, sans-serif; font-size:13px; text-transform:uppercase; letter-spacing:0.08em; }
  article img.hero { width:100%; border-radius:14px; display:block; margin:20px 0 28px; aspect-ratio:3/1; object-fit:cover; }
  article h1 { font-size:36px; margin:8px 0 12px; }
  article .dek { font-size:19px; color:var(--muted); margin:0 0 8px; }
  article p { font-size:18px; }
  article blockquote { border-left:3px solid var(--magenta); margin:24px 0; padding:4px 20px; color:var(--muted); }
  article code { font-family: ui-monospace, monospace; font-size:0.92em; background:var(--codebg); padding:1px 5px; border-radius:5px; }
  article pre { background:var(--codebg); padding:16px; border-radius:10px; overflow-x:auto; }
  article pre code { background:none; padding:0; }
  .source { margin-top:40px; padding-top:16px; border-top:1px solid var(--line); color:var(--muted); font-size:15px; }
</style>
</head>
<body>
<header class="site">
  <a class="brand" href="/">Deep <span>Stack</span></a>
  <div class="tag">by Burak — AI tools, local models, honest costs</div>
</header>
<main><slot /></main>
<footer class="site">Deep Stack by Burak — AI tools, local models, and the honest cost of building with them.</footer>
</body>
</html>
