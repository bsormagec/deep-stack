---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { render } from 'astro:content';
import { getSortedPosts, cleanDek, formatDate, readingTime, imageSize } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((p, i) => ({
    params: { slug: p.id },
    props: { post: p, newer: posts[i - 1], older: posts[i + 1], more: posts.filter((q) => q.id !== p.id).slice(0, 3) },
  }));
}
const { post, newer, older, more } = Astro.props;
const { Content } = await render(post);
const dek = cleanDek(post.data.dek);
const size = imageSize(post.data.image);
const pageUrl = new URL(`/p/${post.id}/`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: dek,
  image: new URL(post.data.image, Astro.site).href,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { '@type': 'Person', name: 'Burak' },
  publisher: { '@type': 'Organization', name: 'Deep Stack by Burak', url: new URL('/', Astro.site).href },
  mainEntityOfPage: pageUrl,
};
---
<Base title={`${post.data.title} — Deep Stack`} description={dek} image={post.data.image} type="article" publishedTime={post.data.date.toISOString()} jsonLd={jsonLd}>
  <div class="progress" aria-hidden="true"><span></span></div>
  <article class="post">
    <header class="post-head narrow">
      <a class="back" href="/">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        All posts
      </a>
      <div class="meta eyebrow">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)} min read</span>
      </div>
      <h1>{post.data.title}</h1>
      {dek && <p class="dek">{dek}</p>}
      <div class="byline">
        <span class="avatar" aria-hidden="true">B</span>
        <span>By <strong>Burak</strong></span>
      </div>
    </header>
    <figure class="hero">
      <img src={post.data.image} alt={post.data.title} width={size?.width} height={size?.height} decoding="async" fetchpriority="high" />
    </figure>
    <div class="prose narrow">
      <Content />
      {post.data.sourceUrl && <p class="source">Source: <a href={post.data.sourceUrl}>{post.data.sourceTitle ?? post.data.sourceUrl}</a></p>}
    </div>
    <aside class="narrow sub-wrap">
      <div class="subscribe">
      <div>
        <p class="sub-title">Get the next breakdown</p>
        <p class="sub-text">Two posts a day on what AI actually costs to build with. No hype, just the math.</p>
      </div>
      <a class="sub-btn" href="/feed">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3a1 1 0 0 0 0 2c7.18 0 13 5.82 13 13a1 1 0 1 0 2 0C20 9.72 13.28 3 5 3Zm0 6a1 1 0 0 0 0 2 7 7 0 0 1 7 7 1 1 0 1 0 2 0 9 9 0 0 0-9-9Zm1.5 6a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z"/></svg>
        RSS feed
      </a>
      </div>
    </aside>
    {(newer || older) && (
      <nav class="pager narrow" aria-label="More posts">
        {older ? (
          <a class="pager-link" href={`/p/${older.id}/`}>
            <span class="eyebrow">← Previous</span>
            <span class="pager-title">{older.data.title}</span>
          </a>
        ) : <span />}
        {newer ? (
          <a class="pager-link next" href={`/p/${newer.id}/`}>
            <span class="eyebrow">Next →</span>
            <span class="pager-title">{newer.data.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
  <section class="wrap more" aria-labelledby="more-h">
    <h2 id="more-h">Latest from Deep Stack</h2>
    <div class="more-grid">
      {more.map((p) => <PostCard post={p} />)}
    </div>
  </section>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('.progress span');
  const article = document.querySelector<HTMLElement>('.prose');
  if (bar && article) {
    let ticking = false;
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight * 0.6;
      const pct = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
      bar.style.transform = `scaleX(${pct})`;
      ticking = false;
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>

<style>
  .progress { position:fixed; top:0; left:0; right:0; height:3px; z-index:60; pointer-events:none; }
  .progress span { display:block; height:100%; background:var(--grad); transform-origin:0 50%; transform:scaleX(0); }
  .narrow { width:100%; max-width:calc(var(--narrow) + 2 * var(--gutter)); margin-left:auto; margin-right:auto; padding-left:var(--gutter); padding-right:var(--gutter); }

  .post-head { padding-top:clamp(28px, 5vw, 56px); }
  .back { display:inline-flex; align-items:center; gap:6px; color:var(--muted); text-decoration:none; font-size:14px; font-weight:500; margin-bottom:28px; padding:6px 12px 6px 8px; margin-left:-8px; border-radius:999px; transition:color .15s, background .15s; }
  .back svg { width:16px; height:16px; }
  .back:hover { color:var(--ink); background:var(--panel); }
  .meta { display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
  .meta time { color:var(--green); }
  .post-head h1 { font-size:clamp(32px, 3.6vw + 16px, 52px); font-weight:800; letter-spacing:-0.035em; line-height:1.06; margin:14px 0 16px; }
  .dek { font-family:var(--serif); font-size:clamp(19px, 0.8vw + 15px, 23px); line-height:1.45; color:var(--muted); margin:0 0 24px; }
  .byline { display:flex; align-items:center; gap:10px; font-size:14px; color:var(--muted); padding-bottom:4px; }
  .byline strong { color:var(--ink); font-weight:600; }
  .avatar { width:32px; height:32px; border-radius:50%; display:grid; place-items:center; font-weight:800; font-size:14px; color:var(--bg); background:var(--grad); }

  .hero { max-width:calc(1000px + 2 * var(--gutter)); margin:32px auto 44px; padding:0 var(--gutter); }
  .hero img { display:block; width:100%; height:auto; max-height:560px; object-fit:cover; border-radius:var(--radius); border:1px solid var(--line); background:var(--panel-2); box-shadow:0 30px 80px -40px rgba(42,210,244,0.25); }

  .source { margin-top:2.5em; padding-top:1.2em; border-top:1px solid var(--line); font-family:var(--sans); font-size:15px; color:var(--muted); }

  .sub-wrap { margin-top:48px; }
  .subscribe { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:24px; border-radius:var(--radius); border:1px solid var(--line-2); background:linear-gradient(135deg, rgba(42,210,244,0.10), rgba(219,111,246,0.10) 55%, rgba(251,172,35,0.08)); }
  .sub-title { margin:0 0 4px; font-weight:700; font-size:18px; letter-spacing:-0.015em; }
  .sub-text { margin:0; color:var(--muted); font-size:15px; }
  .sub-btn { display:inline-flex; align-items:center; gap:8px; white-space:nowrap; height:42px; padding:0 18px; border-radius:999px; background:var(--ink); color:var(--bg); text-decoration:none; font-weight:600; font-size:15px; transition:background .15s, transform .15s; }
  .sub-btn svg { width:16px; height:16px; color:#d97a00; }
  .sub-btn:hover { background:#fff; transform:translateY(-1px); }

  .pager { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:28px; }
  .pager-link { display:flex; flex-direction:column; gap:8px; padding:18px 20px; border:1px solid var(--line); border-radius:var(--radius); background:var(--panel); text-decoration:none; transition:border-color .15s, background .15s; }
  .pager-link:hover { border-color:var(--line-2); background:var(--panel-2); }
  .pager-link.next { text-align:right; }
  .pager-title { color:var(--ink); font-weight:650; font-size:16px; line-height:1.35; letter-spacing:-0.01em; }

  .more { margin-top:clamp(56px, 8vw, 88px); }
  .more h2 { font-size:clamp(22px, 1.4vw + 16px, 28px); font-weight:800; margin:0 0 22px; }
  .more-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:24px; }

  @media (max-width: 960px) {
    .more-grid { grid-template-columns:repeat(2, 1fr); }
    .more-grid > :global(:nth-child(3)) { display:none; }
  }
  @media (max-width: 640px) {
    .back { margin-bottom:20px; }
    .hero { margin:24px auto 32px; padding:0; }
    .hero img { border-radius:0; border-left:0; border-right:0; max-height:420px; }
    .subscribe { flex-direction:column; align-items:stretch; padding:20px; gap:16px; }
    .sub-btn { justify-content:center; }
    .pager { grid-template-columns:1fr; gap:12px; }
    .pager-link.next { text-align:left; }
    .more-grid { grid-template-columns:1fr; gap:16px; }
    .more-grid > :global(:nth-child(3)) { display:flex; }
  }
</style>
