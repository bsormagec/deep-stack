// Cloudflare Workers config: serve the static Astro build from ./dist.
// Needed for preview builds on non-main branches (`wrangler versions upload`),
// which unlike `wrangler deploy` cannot auto-detect the framework.
{
  "name": "deep-stack",
  "compatibility_date": "2026-10-19",
  "assets": { "directory": "./dist" }
}
