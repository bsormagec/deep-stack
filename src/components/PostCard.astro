---
import { cleanDek, formatDate, readingTime, type Post } from '../lib/posts';
interface Props { post: Post; featured?: boolean; eager?: boolean }
const { post, featured = false, eager = false } = Astro.props;
const href = `/p/${post.id}/`;
const dek = cleanDek(post.data.dek);
---
<article class:list={['card', { featured }]}>
  <a class="media" href={href} tabindex="-1" aria-hidden="true">
    <img src={post.data.image} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
  </a>
  <div class="body">
    <div class="meta eyebrow">
      {featured && <span class="badge">Latest</span>}
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min read</span>
    </div>
    <h2 class="title"><a href={href}>{post.data.title}</a></h2>
    {dek && <p class="dek">{dek}</p>}
  </div>
</article>

<style>
  .card { position:relative; display:flex; flex-direction:column; background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; transition:transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .card:hover { transform:translateY(-3px); border-color:var(--line-2); box-shadow:0 18px 40px -20px rgba(0,0,0,0.7), 0 0 0 1px rgba(42,210,244,0.12); }
  .media { display:block; overflow:hidden; background:var(--panel-2); aspect-ratio:2 / 1; }
  .media img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .5s ease; }
  .card:hover .media img { transform:scale(1.03); }
  .body { padding:18px 20px 22px; display:flex; flex-direction:column; gap:10px; flex:1; }
  .meta { display:flex; flex-wrap:wrap; align-items:center; gap:8px; font-size:11.5px; }
  .meta time { color:var(--green); }
  .badge { color:var(--bg); background:var(--grad); padding:3px 8px; border-radius:999px; font-weight:700; letter-spacing:0.06em; }
  .title { margin:0; font-size:20px; font-weight:700; line-height:1.25; }
  .title a { color:var(--ink); text-decoration:none; }
  .title a::after { content:''; position:absolute; inset:0; }
  .title a:focus-visible { outline:none; }
  .card:has(.title a:focus-visible) { outline:2px solid var(--cyan); outline-offset:3px; }
  .dek { margin:0; color:var(--muted); font-family:var(--serif); font-size:16px; line-height:1.55; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }

  .featured .media { aspect-ratio:21 / 9; }
  .featured .body { padding:24px clamp(20px, 3vw, 36px) 30px; gap:12px; }
  .featured .title { font-size:clamp(26px, 2.6vw + 12px, 40px); line-height:1.12; font-weight:800; }
  .featured .dek { font-size:clamp(17px, 0.5vw + 15px, 19px); -webkit-line-clamp:4; color:var(--ink-2); }

  @media (min-width: 900px) {
    .featured { display:grid; grid-template-columns:1.35fr 1fr; }
    .featured .media { aspect-ratio:auto; min-height:360px; }
    .featured .body { justify-content:center; padding:36px 40px; }
  }
  @media (max-width: 560px) {
    .body { padding:16px 16px 18px; gap:8px; }
    .title { font-size:19px; }
    .dek { font-size:15.5px; -webkit-line-clamp:2; }
    .featured .media { aspect-ratio:2 / 1; }
    .featured .body { padding:18px 16px 22px; }
  }
</style>
