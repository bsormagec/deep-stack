---
const { title, description, image, type = 'website', publishedTime, jsonLd } = Astro.props;
const SITE_NAME = 'Deep Stack by Burak';
const DEFAULT_DESC = 'AI tools, local models, and the honest cost of building with them. Twice a day, a Hacker News story gets the math the press release skipped: real prices, real trade-offs, no hype.';
const desc = description || DEFAULT_DESC;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/images/og-default.webp', Astro.site);
const year = new Date().getUTCFullYear();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={desc} />
<meta name="author" content="Burak" />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#0d0b23" />
<meta name="color-scheme" content="dark" />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/feed" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&family=JetBrains+Mono:wght@500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400&display=swap" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && publishedTime && <meta property="article:modified_time" content={publishedTime} />}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
<style is:global>
  :root {
    --bg:#0d0b23; --bg-2:#110e2c; --panel:#161335; --panel-2:#1c1844; --ink:#ecebfb; --ink-2:#c9c5ea; --muted:#a19acb; --faint:#6f69a0;
    --cyan:#2ad2f4; --magenta:#db6ff6; --amber:#fbac23; --green:#2bca6d; --line:#2a2460; --line-2:#3a3380; --codebg:#1c1844;
    --grad:linear-gradient(90deg, var(--cyan), var(--magenta), var(--amber));
    --sans:'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --serif:'Source Serif 4', ui-serif, Georgia, 'Times New Roman', serif;
    --mono:'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --wide:1120px; --narrow:700px; --gutter:clamp(16px, 4vw, 32px); --radius:16px;
  }
  *, *::before, *::after { box-sizing:border-box; }
  html { -webkit-text-size-adjust:100%; text-size-adjust:100%; scroll-behavior:smooth; scroll-padding-top:80px; }
  body {
    margin:0; min-height:100vh; display:flex; flex-direction:column;
    background:
      radial-gradient(900px 480px at 12% -120px, rgba(42,210,244,0.12), transparent 70%),
      radial-gradient(800px 460px at 92% -160px, rgba(219,111,246,0.12), transparent 70%),
      var(--bg);
    background-repeat:no-repeat; color:var(--ink); font-family:var(--sans); line-height:1.6;
    -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale; text-rendering:optimizeLegibility;
  }
  img { max-width:100%; height:auto; }
  a { color:var(--cyan); }
  ::selection { background:rgba(219,111,246,0.35); color:#fff; }
  :focus-visible { outline:2px solid var(--cyan); outline-offset:3px; border-radius:6px; }
  h1, h2, h3, h4 { font-family:var(--sans); letter-spacing:-0.025em; line-height:1.15; text-wrap:balance; }
  .wrap { width:100%; max-width:var(--wide); margin:0 auto; padding-left:var(--gutter); padding-right:var(--gutter); }
  .eyebrow { font-family:var(--mono); font-size:12px; font-weight:500; letter-spacing:0.08em; text-transform:uppercase; color:var(--muted); }
  .grad-text { background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .skip { position:absolute; left:-9999px; top:8px; z-index:100; background:var(--panel); color:var(--ink); padding:8px 14px; border-radius:8px; }
  .skip:focus { left:8px; }

  /* Header */
  header.site { position:sticky; top:0; z-index:50; background:rgba(13,11,35,0.72); backdrop-filter:saturate(160%) blur(14px); -webkit-backdrop-filter:saturate(160%) blur(14px); border-bottom:1px solid rgba(42,36,96,0.7); padding-top:env(safe-area-inset-top); }
  header.site .wrap { display:flex; align-items:center; justify-content:space-between; gap:16px; height:64px; }
  .brand { display:inline-flex; align-items:center; gap:10px; color:var(--ink); text-decoration:none; font-weight:800; font-size:19px; letter-spacing:-0.03em; white-space:nowrap; }
  .brand svg { width:30px; height:30px; flex:none; }
  .brand .by { font-weight:500; font-size:13px; color:var(--muted); letter-spacing:0; margin-left:2px; }
  nav.site { display:flex; align-items:center; gap:4px; }
  nav.site a { color:var(--ink-2); text-decoration:none; font-size:14px; font-weight:500; padding:8px 12px; border-radius:999px; transition:background .15s, color .15s; display:inline-flex; align-items:center; gap:6px; }
  nav.site a:hover { background:var(--panel); color:var(--ink); }
  nav.site a.rss { color:var(--amber); }
  nav.site a.rss svg { width:15px; height:15px; }
  main { flex:1; }

  /* Footer */
  footer.site { margin-top:72px; border-top:1px solid var(--line); background:linear-gradient(180deg, transparent, rgba(22,19,53,0.6)); padding-bottom:env(safe-area-inset-bottom); }
  footer.site .wrap { display:flex; flex-wrap:wrap; justify-content:space-between; gap:24px; padding-top:36px; padding-bottom:36px; }
  footer.site p { margin:8px 0 0; color:var(--muted); font-size:14px; max-width:460px; }
  footer.site .links { display:flex; gap:20px; align-items:flex-start; font-size:14px; }
  footer.site .links a { color:var(--ink-2); text-decoration:none; }
  footer.site .links a:hover { color:var(--cyan); }
  footer.site .copy { width:100%; color:var(--faint); font-size:13px; border-top:1px solid rgba(42,36,96,0.6); padding-top:20px; }

  /* Article prose */
  .prose { font-family:var(--serif); font-size:clamp(18px, 1.2vw + 12px, 20px); line-height:1.72; color:var(--ink-2); overflow-wrap:break-word; }
  .prose > :first-child { margin-top:0; }
  .prose p { margin:0 0 1.25em; }
  .prose strong { color:var(--ink); font-weight:650; }
  .prose a { color:var(--ink); text-decoration:underline; text-decoration-color:rgba(42,210,244,0.6); text-decoration-thickness:1.5px; text-underline-offset:3px; overflow-wrap:anywhere; transition:color .15s, text-decoration-color .15s; }
  .prose a:hover { color:var(--cyan); text-decoration-color:var(--cyan); }
  .prose h2 { font-size:clamp(23px, 1.4vw + 17px, 28px); color:var(--ink); margin:2.1em 0 0.7em; }
  .prose h3 { font-size:clamp(19px, 0.8vw + 16px, 22px); color:var(--ink); margin:1.8em 0 0.6em; }
  .prose h2 + h3 { margin-top:0.8em; }
  .prose ul, .prose ol { padding-left:1.3em; margin:0 0 1.25em; }
  .prose li { margin:0.4em 0; padding-left:0.2em; }
  .prose li::marker { color:var(--magenta); }
  .prose ol li::marker { font-family:var(--mono); font-size:0.85em; }
  .prose blockquote { margin:1.8em 0; padding:0.2em 0 0.2em 1.1em; border-left:3px solid var(--magenta); color:var(--ink); font-style:italic; }
  .prose blockquote p:last-child { margin-bottom:0; }
  .prose hr { border:0; height:1px; background:var(--grad); opacity:0.5; margin:2.5em 0; }
  .prose code { font-family:var(--mono); font-size:0.84em; background:var(--codebg); border:1px solid var(--line); padding:0.1em 0.4em; border-radius:6px; color:var(--ink); }
  .prose pre { background:var(--codebg); border:1px solid var(--line); padding:16px 18px; border-radius:12px; overflow-x:auto; font-size:15px; line-height:1.6; }
  .prose pre code { background:none; border:0; padding:0; font-size:inherit; }
  .prose img { border-radius:12px; }
  .prose table { width:100%; border-collapse:collapse; font-family:var(--sans); font-size:15px; display:block; overflow-x:auto; }
  .prose th, .prose td { border-bottom:1px solid var(--line); padding:10px 12px; text-align:left; }

  @media (max-width: 560px) {
    .brand .by { display:none; }
    nav.site a { padding:8px 10px; }
    nav.site a .label-long { display:none; }
    .prose { line-height:1.66; }
    .prose p { margin-bottom:1.15em; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior:auto; }
    *, *::before, *::after { transition:none !important; animation:none !important; }
  }
</style>
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<header class="site">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Deep Stack by Burak — home">
      <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#1c1844"/><rect x="14" y="16" width="36" height="8" rx="4" fill="#2ad2f4"/><rect x="14" y="29" width="36" height="8" rx="4" fill="#db6ff6"/><rect x="14" y="42" width="24" height="8" rx="4" fill="#fbac23"/></svg>
      <span>Deep <span class="grad-text">Stack</span></span><span class="by">by Burak</span>
    </a>
    <nav class="site" aria-label="Main">
      <a href="/#archive">Archive</a>
      <a class="rss" href="/feed" aria-label="RSS feed">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3a1 1 0 0 0 0 2c7.18 0 13 5.82 13 13a1 1 0 1 0 2 0C20 9.72 13.28 3 5 3Zm0 6a1 1 0 0 0 0 2 7 7 0 0 1 7 7 1 1 0 1 0 2 0 9 9 0 0 0-9-9Zm1.5 6a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z"/></svg>
        <span class="label-long">RSS</span>
      </a>
    </nav>
  </div>
</header>
<main id="content"><slot /></main>
<footer class="site">
  <div class="wrap">
    <div>
      <a class="brand" href="/"><span>Deep <span class="grad-text">Stack</span></span><span class="by">by Burak</span></a>
      <p>AI tools, local models, and the honest cost of building with them. Real prices, real trade-offs, no hype.</p>
    </div>
    <div class="links">
      <a href="/#archive">Archive</a>
      <a href="/feed">RSS</a>
      <a href="/sitemap.xml">Sitemap</a>
    </div>
    <div class="copy">© {year} Deep Stack by Burak</div>
  </div>
</footer>
</body>
</html>
