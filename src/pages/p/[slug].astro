---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} — Deep Stack`} description={post.data.dek}>
  <article>
    <time>{post.data.date.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric', timeZone:'UTC' }).toUpperCase()}</time>
    <h1>{post.data.title}</h1>
    <p class="dek">{post.data.dek}</p>
    <img class="hero" src={post.data.image} alt="" />
    <Content />
    {post.data.sourceUrl && <p class="source">Source: <a href={post.data.sourceUrl}>{post.data.sourceTitle ?? post.data.sourceUrl}</a></p>}
  </article>
</Base>
